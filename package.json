{
  "name": "ai-travel-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "npm run start --workspace @ai-travel/server",
    "deploy:migrate": "npm run prisma:deploy --workspace @ai-travel/server",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit && npm run typecheck --workspace @ai-travel/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "dev:api": "npm run dev --workspace @ai-travel/server",
    "test:api": "npm run test --workspace @ai-travel/server",
    "db:migrate": "npm run prisma:migrate --workspace @ai-travel/server",
    "db:studio": "npm run prisma:studio --workspace @ai-travel/server"
  },
  "dependencies": {
    "ably": "^2.27.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
