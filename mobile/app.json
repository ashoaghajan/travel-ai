{
  "expo": {
    "name": "AI Travel",
    "slug": "ai-travel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aitravel.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aitravel.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "aitravel",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@maplibre/maplibre-react-native",
      [
        "expo-audio",
        {
          "microphonePermission": "AI Travel uses the microphone so you can speak a trip instead of typing it. Recordings are transcribed and never stored."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
