// Accounts, sessions and trips.
//
// Saved activities, settings and conversations stay in the browser for now;
// the relations for those are deliberately absent rather than
// declared-and-unused, so the schema says what is actually true.
//
// Postgres. The move from SQLite was the provider swap and a fresh migration
// this file predicted, and it happened for deployment: a SQLite database is a
// file, and every host worth deploying to hands you an empty filesystem on
// each release. Accounts and sessions cannot live somewhere that is wiped.
//
// Two conventions worth stating, because Trip is where they first get tested:
//
// No `enum`. Kinds and statuses are plain strings, validated by zod at the
// edge. It costs nothing and it is what kept the SQLite-to-Postgres swap
// cheap; there is no reason to spend that portability on a spelling check the
// API already performs.
//
// One `Json` column, deliberately. `Trip.itinerary` is the only place a
// document beats tables here: the editor already replaces the whole itinerary
// on every save, nothing ever queries inside one, and the nested ids are
// client-generated and stable. Relational days and activities would turn each
// edit into a three-way diff across two child tables for no query anyone
// makes. Keep the JSON byte-identical to `ItineraryDay[]` so a later backfill
// is a mechanical `jsonb_array_elements`.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 takes the connection URL from prisma.config.ts, not from here.
datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  /// As typed. Shown back to the user, never used for lookup.
  email    String
  /// lower(trim(email)) — case-insensitive uniqueness without losing their casing.
  emailKey String @unique
  name     String

  /// Null for an account that only ever signed in through a provider.
  passwordHash String?

  /// Set once the browser's local data has been claimed by this account (Phase 4).
  localImportCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The trip last opened, so a reload can offer to resume it.
  ///
  /// `SetNull` rather than `Cascade`: deleting a trip must never delete the
  /// person, and must never leave this pointing at a row that is gone.
  activeTripId String?
  activeTrip   Trip?   @relation("ActiveTrip", fields: [activeTripId], references: [id], onDelete: SetNull)

  refreshTokens   RefreshToken[]
  identities      AuthIdentity[]
  trips           Trip[]          @relation("OwnedTrips")
  settings        UserSettings?
  bookings        Booking[]
  savedActivities SavedActivity[]
  recentSearches  RecentSearch[]
  chatHistory     ChatHistory?

  /// Two relations to one model, so both need naming — Prisma cannot tell
  /// which side of a `DirectMessage` a `User[]` was meant to be.
  sentMessages     DirectMessage[] @relation("SentMessages")
  receivedMessages DirectMessage[] @relation("ReceivedMessages")

  /// Read cursors, one per conversation this account has opened. Declared only
  /// because Prisma requires both ends of a relation; nothing joins from here.
  conversationReads ConversationRead[]
}

/// App preferences, one row per account.
///
/// Columns rather than a JSON blob, unlike `Trip.itinerary`: the shape is tiny
/// and fixed, every field is scalar, and nothing about it resembles a document.
/// The reason the itinerary is JSON — whole-value replacement of a nested,
/// never-queried structure — applies to none of this.
model UserSettings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 'system' | 'light' | 'dark'. A string, not an enum — see the header.
  theme String @default("system")

  /// ISO 4217, e.g. 'USD'. Display only: prices are quoted and stored in USD
  /// and converted at render time, so this changes what a reader sees and
  /// nothing about what anything cost.
  currency String @default("USD")

  tripReminders Boolean @default(true)
  priceAlerts   Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// One saved trip, with its whole itinerary in a single JSON column.
model Trip {
  /// Client-format (`trip_<uuid>`), not a database default.
  ///
  /// The client mints ids for trips and for the days and activities inside
  /// them, and the localStorage import depends on preserving them: keeping the
  /// same id is what makes that endpoint idempotent, so re-running it cannot
  /// duplicate a trip.
  id     String @id
  userId String
  user   User   @relation("OwnedTrips", fields: [userId], references: [id], onDelete: Cascade)

  /// Identifies the generated draft this trip came from.
  ///
  /// The idempotency key for saving: a double click, a second tab, or the same
  /// conversation after a reload all carry the same draft, and the unique
  /// constraint below is what makes the second save return the first trip
  /// rather than create a twin. Nullable because a hand-built trip has no
  /// draft — and Postgres treats NULLs as distinct, so any number of them
  /// coexist under that constraint.
  draftId String?

  title       String
  destination String

  /// Both nullable: a trip saved before these existed carries only
  /// `destination`, and three places resolve that at read time. Do not
  /// backfill them during the import — a guess here becomes a wrong country
  /// filter in the explorer.
  destinationCountry String?
  destinationCity    String?

  /// `YYYY-MM-DD` strings, not `DateTime`.
  ///
  /// A trip's dates are calendar days, not instants. Stored as timestamps they
  /// acquire a timezone, and a trip starting the 2nd in Yerevan becomes the
  /// 1st for a reader in New York.
  startDate String
  endDate   String

  travellers Int
  coverImage String

  /// `ItineraryDay[]`. Validated by zod on every write — see the header.
  itinerary Json

  /// `TripNote[]`. Nullable, because a trip saved before notes existed carries
  /// none and the client reads a missing list as an empty one rather than
  /// forcing a migration. Notes live on the trip rather than in their own
  /// table for the same reason the itinerary does: nothing queries across
  /// them, and they are meaningless without the trip.
  notes Json?

  /// Display estimates, not money. `Float` rather than `Decimal` because
  /// `Prisma.Decimal` serialises to an object and would need a mapper.
  flightsEstimate    Float?
  hotelsEstimate     Float?
  activitiesEstimate Float?

  /// Bumped on every write, checked on every patch.
  ///
  /// Two tabs editing one trip would otherwise silently overwrite each other:
  /// both read version 3, both send a whole itinerary, and the slower write
  /// wins with no sign that the other happened.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activeFor User[]    @relation("ActiveTrip")
  bookings  Booking[]

  @@unique([userId, draftId])
  @@index([userId, createdAt(sort: Desc)])
}

/// A flight, stay, ticket or activity the reader has saved or booked.
///
/// One user-scoped collection rather than four tables and rather than a field
/// on `Trip`. A booking outlives the search that produced it, and it can exist
/// before anyone has decided which trip it belongs to — so it is its own
/// record with a nullable pointer, not a child of one.
model Booking {
  /// Client-format (`bk_<uuid>`), like a trip's, and for the same reason: the
  /// localStorage import preserves ids so that re-running it cannot duplicate.
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The trip this belongs to, or null for one attached to nothing yet.
  ///
  /// `SetNull`, deliberately, and it is the whole reason this is a relation
  /// rather than a loose string. Deleting a trip must not destroy the
  /// confirmation number for a flight that was actually paid for — the
  /// booking becomes unassigned and the reader can still find it. An itinerary
  /// activity is a guess; a booking is a fact, and facts survive the plan
  /// they were made under.
  tripId String?
  trip   Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  /// 'flight' | 'hotel' | 'ticket' | 'activity'. Strings, not enums — see the
  /// header.
  kind   String
  /// 'saved' | 'booked'.
  status String @default("saved")

  title String

  /// ISO calendar date, `YYYY-MM-DD`. Empty when unknown, which is a group of
  /// its own on the bookings tab rather than a guess at the trip's start.
  date String

  /// Check-out, for a stay. `date` is the check-in. Only a hotel has one: a
  /// flight happens on a day, a stay occupies a range, and the nights in that
  /// range are what a nightly rate multiplies by.
  endDate String?

  /// Confirmation number, as the provider issued it. Empty until booked.
  ///
  /// Stored plainly. A booking reference is not a credential — it is useful
  /// only to someone who already has the airline's site open — and the
  /// account scoping is the protection that matters.
  reference String @default("")

  /// What it cost, once known. Null is not zero.
  price Float?

  /// What `price` measures, so a total can add it to other prices correctly:
  /// a hotel's is per night, a flight's is per person. Null means the price is
  /// already a total, which is true of every hand-typed one — and is the safe
  /// default, because it makes an old row sum exactly as it always did.
  priceBasis Json?

  /// The confirmation page, if the reader has one.
  url String?

  /// A copy of the search result this came from — provider, image, deep link,
  /// the price as quoted. A snapshot rather than a reference: the search that
  /// produced it will not return the same row tomorrow.
  source Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([tripId])
}

/// One external account someone can sign in with.
///
/// Keyed on the provider's own id rather than on email, which Google
/// explicitly recommends: a Google account's email address can change, and
/// following it would either lose the link or hand the account to whoever
/// inherits the old address.
model AuthIdentity {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 'google' today. A string rather than an enum — SQLite has none.
  provider       String
  /// Google's `sub` claim.
  providerUserId String

  /// As the provider reported it, for display on the profile screen. Not used
  /// for lookup, and not kept in step with the account's own email.
  email String?

  createdAt DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

/// One issued refresh token. Rotated on every use; never reused.
model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// sha256 of the token. The raw value exists only in the client's cookie,
  /// so a leaked database cannot be replayed against us.
  tokenHash String @unique

  /// Every token descended from one sign-in. Replaying any dead member kills
  /// the whole family — that is the theft signal.
  familyId String

  expiresAt    DateTime
  revokedAt    DateTime?
  /// The token this one was rotated into, for tracing a family.
  replacedById String?

  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
}

/// An attraction the reader bookmarked from the explorer.
///
/// The whole `Activity` is stored, not just its id. The explorer's own cache
/// expires in five minutes and is keyed to one city, so an id alone would
/// leave a saved item unrenderable the moment the reader looked elsewhere —
/// the list would need a network round trip per row to draw itself.
model SavedActivity {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The provider's own id — an OpenTripMap xid, or a Viator product id.
  activityId String

  /// Promoted out of the payload so the shortlist can be filtered in SQL
  /// without reading every row's JSON.
  category String
  title    String

  /// The whole `Activity`, as the explorer had it. See the model docblock.
  activity Json

  savedAt DateTime @default(now())

  /// Saving the same attraction again moves it to the top rather than
  /// duplicating it — an upsert, which needs this to have something to
  /// conflict on.
  @@unique([userId, activityId])
  @@index([userId, savedAt(sort: Desc)])
}

/// One flight search the reader ran, so a return visit reopens where they were.
model RecentSearch {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 'flight' today. A string, like every other kind in this schema.
  kind String @default("flight")

  /// The whole `FlightSearchQuery`. JSON because it mirrors a form's shape,
  /// which will change, and nothing queries inside it.
  query Json

  /// The server-side form of the client's `isSameFlightSearch` — the same
  /// route on the same dates for the same party is one search, not five.
  fingerprint String

  searchedAt DateTime @default(now())

  @@unique([userId, kind, fingerprint])
  @@index([userId, searchedAt(sort: Desc)])
}

/// The planner conversation, so a reload resumes rather than restarts.
///
/// One row per account holding the whole message list, rather than the
/// `Conversation` + `ChatMessage` pair `STAGE_2_PLAN.md` sketched. That design
/// supports several named conversations and ordered rows; the app has exactly
/// one conversation and only ever reads and writes it whole. This is the same
/// call as `Trip.itinerary` for the same reasons — nothing queries inside it,
/// and a relational shape would buy ordering machinery for a list that already
/// arrives in order.
model ChatHistory {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `PlannerMessage[]`.
  messages Json

  updatedAt DateTime @updatedAt
}

/// One thing somebody said to one other person.
///
/// Replaced the app's single public room, whose table was dropped in
/// `20260812..._drop_lobby_messages`. The shape is nearly the same — plain
/// text, a client-minted id for retries, a soft delete — and the difference
/// that matters is that a message now has a recipient, so who may read it is a
/// fact about the row rather than about the app.
///
/// A row per message, unlike `ChatHistory` above, and for the opposite reasons.
/// That is one transcript per account, read and written whole by its owner;
/// this is appended to by two writers and read as a tail, and a JSON document
/// would make every send a read-modify-write of the same value.
model DirectMessage {
  id String @id @default(uuid())

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User   @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  /// `min(senderId, recipientId):max(...)`, written on create.
  ///
  /// A conversation is an unordered pair, and this is what lets one index serve
  /// it. Without it every thread read is `(sender = A AND recipient = B) OR
  /// (sender = B AND recipient = A)`, which no single index covers — Postgres
  /// takes both branches and merges. Computed server-side from the
  /// authenticated sender and the path recipient, never accepted from a client.
  pairKey String

  /// Plain text, capped by zod at the edge. Never markup: it is rendered as a
  /// text node, and nothing anywhere linkifies it.
  body String

  /// The id the sending browser minted. With the unique constraint below it
  /// makes a retry idempotent, which matters because a sleeping instance takes
  /// a minute to answer and the reader will press the button again long before
  /// it does. It also lets the sender retire its own optimistic bubble.
  clientMessageId String

  /// Withdrawn by its author. Soft, so an id already on the other person's
  /// screen still resolves — and so that adding moderation later does not need
  /// data that was hard-deleted before anybody asked for it.
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([senderId, clientMessageId])
  /// The one query a thread has: the newest fifty of a pair.
  @@index([pairKey, createdAt(sort: Desc)])
  /// Unread counts, which are always asked per recipient.
  @@index([recipientId, createdAt(sort: Desc)])
}

/// How far one person has read in one conversation.
///
/// A cursor rather than a `readAt` on every message: marking a thread read is
/// then a single upsert instead of an UPDATE across every row in it, and the
/// unread count is a COUNT with one predicate.
///
/// Deliberately not a foreign key on `otherUserId`. The row is worthless once
/// that account is gone, but it is also harmless, and a cascade here would mean
/// a second relation pair on `User` for a table nothing ever joins from.
model ConversationRead {
  userId      String
  otherUserId String
  lastReadAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, otherUserId])
}
