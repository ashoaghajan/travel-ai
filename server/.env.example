# Copy to server/.env and fill in. server/.env is git-ignored.
#
# Unlike the SPA's VITE_ variables, nothing here reaches the browser — these
# are real secrets and should be treated as such.

# Postgres. `docker compose up -d` from the repo root serves exactly this URL
# — 5433 on the host, because 5432 is too often already taken.
#
# In production this is whatever the platform hands you. Managed Postgres
# usually requires TLS, so expect a `?sslmode=require` on the end of it; the
# tests use their own database (`aitravel_test`), created on demand.
DATABASE_URL="postgresql://aitravel:aitravel@localhost:5433/aitravel"

# Signs access tokens. At least 32 characters; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it invalidates every access token in the wild — at most 15 minutes
# of inconvenience, since refresh cookies are opaque and unaffected.
JWT_SECRET=

# Optional; the defaults are the ones the design assumes. PORT must match the
# proxy target in the SPA's vite.config.ts.
# PORT=3001
# ACCESS_TOKEN_TTL_SECONDS=900
# SESSION_TTL_HOURS — an absolute cap measured from sign-in, not an idle
# timeout: refreshing does not extend it, so six hours means a fresh login
# afterwards however busy the session was. Fractional values are accepted,
# which is the easy way to watch the expiry happen (0.05 is three minutes).
# SESSION_TTL_HOURS=6

# Google OAuth web client id — the same value as VITE_GOOGLE_CLIENT_ID in
# .env.local. Used as the audience when verifying an ID token. Optional: the
# Google endpoints answer PROVIDER_NOT_CONFIGURED without it, and the rest of
# the API is unaffected. No client secret is involved in this flow.
GOOGLE_CLIENT_ID=

# Travelpayouts — real flight prices and the booking links that go with them.
# Sign up at https://www.travelpayouts.com, then take the token from
# https://app.travelpayouts.com/profile/api-token and the marker (your
# affiliate id) from the same profile.
#
# Optional, like GOOGLE_CLIENT_ID above. Without the token the search endpoints
# answer PROVIDER_NOT_CONFIGURED, the app falls back to clearly-labelled sample
# prices, and everything else works. Without the marker the links still work —
# they just earn no commission.
#
# The token is a real secret and must never be copied into a VITE_ variable:
# anything with that prefix is compiled into the browser bundle.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# OpenTripMap — the places directory behind hotel listings. The same key the
# SPA compiles in as VITE_OPENTRIPMAP_API_KEY, so not a secret; it lives here
# because the hotel search runs server-side. Free key: https://opentripmap.io/product
# Optional: without it, hotel search answers PROVIDER_NOT_CONFIGURED and the
# client falls back to clearly-labelled sample stays.
OPENTRIPMAP_API_KEY=

# LiteAPI — hotel prices, ratings and photos. Sign up at https://liteapi.travel,
# then Dashboard > Profile settings > Sandbox key.
#
# A real secret, like TRAVELPAYOUTS_TOKEN: never copy it into a VITE_ variable.
#
# Optional. Without it, hotel search still returns real stays from OpenTripMap
# with no prices — which is what it did before this was wired in.
#
# Not Amadeus, and not Hotellook, deliberately. Amadeus's API hostnames carry
# no DNS record at all (checked against its own authoritative nameserver) and
# Hotellook has retired its API. Neither is a credentials problem, so neither
# is fixed by signing up. See the note in src/env.ts.
LITEAPI_KEY=

# Anthropic — the model behind the planner conversation. Get a key from
# https://console.anthropic.com/settings/keys
#
# A real secret, like TRAVELPAYOUTS_TOKEN: never copy it into a VITE_ variable,
# because anything with that prefix is compiled into the browser bundle. It is
# also the only key here billed per request, which is why POST /api/planner/chat
# requires a signed-in account and is throttled harder than the search routes.
#
# Optional: without it the planner endpoint answers PROVIDER_NOT_CONFIGURED and
# the client falls back to its own rules engine — weather and location lookups
# still work, and trip requests still produce a template itinerary.
ANTHROPIC_API_KEY=
