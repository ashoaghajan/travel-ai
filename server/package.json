{
  "name": "@ai-travel/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--use-system-ca tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "NODE_OPTIONS=--use-system-ca tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
