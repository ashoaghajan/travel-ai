# Copy to .env.local and fill in. .env.local is git-ignored.
#
# NOTE: anything prefixed VITE_ is inlined into the client bundle at build
# time and is readable by anyone who loads the site. Fine for a free-tier,
# read-only key in Stage 1; Stage 2 should proxy this through the backend.
VITE_OPENTRIPMAP_API_KEY=

# Affiliate ids for the booking partners (Screen 7). All optional: leave them
# empty and the outbound links still work, just untracked.
#
# Each program issues its id on approval, and the query parameter it expects is
# named in its own dashboard — confirm the names in `partner.links.ts` against
# the programme before relying on the commission.
VITE_EXPEDIA_AFFILIATE_ID=
VITE_BOOKING_AFFILIATE_ID=
VITE_TRIP_AFFILIATE_ID=
VITE_GETYOURGUIDE_AFFILIATE_ID=

# Google OAuth web client id, for "Sign in with Google". Optional: leave it
# empty and the button simply does not appear.
#
# Public by design — it names which app a credential was minted for, and the
# server checks it as the audience. The client *secret* is not part of this
# flow; do not put one anywhere. Use the same value as GOOGLE_CLIENT_ID in
# server/.env. See README "Sign in with Google" for how to create one.
VITE_GOOGLE_CLIENT_ID=
